---
// ETF UNSA - Gallery Example
import NoSidebar from '../../../layouts/NoSidebar.astro';
import ExampleSnippet from '../../../components/common/ExampleSnippet.astro';

const breadcrumbItems = [
  { label: 'Početna', href: '/' },
  { label: 'Primjeri', href: '#' },
  { label: 'Tekst & Mediji', href: '#' },
  { label: 'Galerija', href: '#', active: true },
];

const galleryImages = [
  { src: 'https://placehold.co/600x400/EEE/31343C', title: 'Image 1' },
  { src: 'https://placehold.co/600x400/DDD/31343C', title: 'Image 2' },
  { src: 'https://placehold.co/600x400/CCC/31343C', title: 'Image 3' },
  { src: 'https://placehold.co/600x400/BBB/31343C', title: 'Image 4' },
  { src: 'https://placehold.co/600x400/AAA/31343C', title: 'Image 5' },
  { src: 'https://placehold.co/600x400/999/31343C', title: 'Image 6' },
];

const gridGallery3Code = `<div class="row g-3">
  <div class="col-sm-6 col-md-4">
    <div class="card h-100 border-0 shadow-sm">
      <a href="#" class="d-block text-decoration-none">
        <img src="..." class="card-img-top img-fluid rounded" alt="Image 1" />
      </a>
      <div class="card-body p-2 text-center">
        <small class="text-muted">Image 1</small>
      </div>
    </div>
  </div>
  <div class="col-sm-6 col-md-4">
    <div class="card h-100 border-0 shadow-sm">
      <a href="#" class="d-block text-decoration-none">
        <img src="..." class="card-img-top img-fluid rounded" alt="Image 2" />
      </a>
      <div class="card-body p-2 text-center">
        <small class="text-muted">Image 2</small>
      </div>
    </div>
  </div>
  <!-- More columns... -->
</div>`;

const gridGallery4Code = `<div class="row g-2">
  <div class="col-6 col-md-3">
    <a href="#" class="d-block position-relative overflow-hidden rounded group-hover-zoom">
      <img src="..." class="img-fluid w-100 shadow-sm" alt="Image 1" />
    </a>
  </div>
  <div class="col-6 col-md-3">
    <a href="#" class="d-block position-relative overflow-hidden rounded group-hover-zoom">
      <img src="..." class="img-fluid w-100 shadow-sm" alt="Image 2" />
    </a>
  </div>
  <!-- More columns... -->
</div>`;
---

<NoSidebar
  title="Galerija (Gallery)"
  breadcrumbItems={breadcrumbItems}
  bannerTitle="Galerija"
  bannerSubtitle="Primjer prikaza galerije slika koristeći Grid sistem i Lightbox"
  bannerSize="xs"
>
  <div class="row">
    <div class="col-12">
      <ExampleSnippet
        title="Gallery Grid (3 Columns)"
        description="Galerija koristeći <code>.gallery.gallery-3</code> komponentu sa Lightbox integracijom."
        code={`<div class="gallery gallery-3">
  <div class="gallery-item">
    <a href="..." class="glightbox" data-gallery="gallery1">
      <img src="..." alt="Image 1" />
    </a>
  </div>
  <!-- ... -->
</div>`}
      >
        <div class="gallery gallery-3">
          {
            galleryImages.map((img, index) => (
              <div class="gallery-item">
                <a
                  href={img.src}
                  class="glightbox"
                  data-gallery="gallery1"
                  data-description={img.title}
                >
                  <img src={img.src} alt={img.title} />
                </a>
              </div>
            ))
          }
        </div>
      </ExampleSnippet>

      <ExampleSnippet
        title="Gallery Grid (4 Columns)"
        description="Kompatknija galerija sa 4 kolone <code>.gallery.gallery-4</code>."
        code={`<div class="gallery gallery-4">...</div>`}
      >
        <div class="gallery gallery-4">
          {
            galleryImages.slice(0, 4).map((img) => (
              <div class="gallery-item">
                <a href={img.src} class="glightbox" data-gallery="gallery2">
                  <img src={img.src} alt={img.title} />
                </a>
              </div>
            ))
          }
        </div>
      </ExampleSnippet>

      <ExampleSnippet
        title="Gallery Grid (6 Columns)"
        description="Maksimalna gustina <code>.gallery.gallery-6</code>."
        code={`<div class="gallery gallery-6">...</div>`}
      >
        <div class="gallery gallery-6">
          {
            galleryImages.map((img) => (
              <div class="gallery-item">
                <a href={img.src} class="glightbox" data-gallery="gallery3">
                  <img src={img.src} alt={img.title} />
                </a>
              </div>
            ))
          }
        </div>
      </ExampleSnippet>
    </div>
  </div>
</NoSidebar>

<script>
  import GLightbox from 'glightbox';

  // Initialize GLightbox
  const lightbox = GLightbox({
    touchNavigation: true,
    loop: true,
    autoplayVideos: true,
  });
</script>
